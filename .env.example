# Supabase가 제공하는 PostgreSQL 직접 연결 문자열입니다.
# 예: postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=

# 추후 자연어 질문 해석과 결과 설명에 사용할 OpenAI API 키입니다.
OPENAI_API_KEY=

# data.go.kr Open API 호출에 사용할 서비스 키입니다.
DATA_GO_KR_SERVICE_KEY=

# 기존 n8n 질문 워크플로를 거치는 분석 서비스 /ask 주소입니다.
# 로컬 기본값은 http://localhost:8090/ask 이므로 보통 설정하지 않아도 됩니다.
ANALYSIS_SERVICE_URL=
