# 운영(기본) 읽기 전용 PostgreSQL 직접 연결 문자열입니다.
# 로컬 PostgreSQL 또는 Supabase 연결 문자열을 넣습니다.
# 예: postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=

# 비교·조회용 보조 PostgreSQL(예: Supabase) 읽기 전용 연결 문자열입니다.
# 설정하면 로컬과 보조 DB의 읽기 전용 카탈로그를 비교해 최신 적재본을 선택하는 데 사용합니다.
# 비워 두면 DATABASE_URL 한 곳만 사용합니다.
SUPABASE_ANALYSIS_DB_URL=

# 자연어 질문을 구조화된 조회 계획으로 해석할 때 사용할 OpenAI API 키입니다.
OPENAI_API_KEY=

# OpenAI 모델 이름입니다. 비워 두면 기본값 gpt-4o-mini 를 사용합니다.
OPENAI_MODEL=

# data.go.kr Open API 호출에 사용할 서비스 키입니다.
DATA_GO_KR_SERVICE_KEY=
